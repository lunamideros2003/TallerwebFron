# =============================================================================
#  Frontend environment (Vite). Copy to `.env.local` for local development and
#  type the same keys in Vercel -> Project -> Settings -> Environment Variables.
#  Every VITE_* value is embedded in the bundle: never put a service-role key
#  or any other server secret here.
# =============================================================================

# Render backend URL. Local: http://127.0.0.1:3000
# Render:   https://<service-name>.onrender.com  (no trailing slash)
VITE_API_URL=http://127.0.0.1:3000

# Must match JURY_TOKEN on Render. The jury page opens /ws/jury with this token.
VITE_JURY_TOKEN=demo-jury-token

# Must match AUDITOR_TOKEN on Render. Used by /ws/verification.
VITE_AUDITOR_TOKEN=demo-auditor-token

# Topic opened by the public page when the URL has no ?topic= parameter.
VITE_DEFAULT_TOPIC=dept
